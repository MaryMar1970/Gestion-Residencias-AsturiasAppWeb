# Configuración de codificación y finales de línea para ResidenciaApp.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{bas,cls,frm}]
charset = windows-1252
end_of_line = crlf
insert_final_newline = false

[*.{ps1,vbs}]
charset = utf-8
end_of_line = crlf

[*.{md,json,xml,py}]
charset = utf-8
end_of_line = lf