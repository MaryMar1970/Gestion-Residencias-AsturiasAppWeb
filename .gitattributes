# Texto: Markdown y formatos de intercambio en LF; VBA/Windows en CRLF.
* text=auto
.gitattributes text eol=lf
.editorconfig text eol=lf

# Fuentes y documentos de texto.
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.vbs text eol=crlf

# Código VBA: conservar la convención nativa de Windows.
*.bas text eol=crlf
*.cls text eol=crlf
*.frm text eol=crlf

# Binarios: no normalizar bytes ni saltos de línea.
*.xlsm binary
*.xls binary
*.xltm binary
*.xlsx binary
*.accdb binary
*.frx binary
*.docx binary
*.pdf binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary